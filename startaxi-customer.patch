+.floating { width: 48px; height: 48px; font-size: 1.35rem; line-height: 1; }
+.map-actions { position: absolute; z-index: 2; left: 50%; transform: translateX(-50%); bottom: max(2.15rem, calc(env(safe-area-inset-bottom) + 1rem)); width: min(calc(100% - 8rem), 23rem); min-width: 11rem; display: grid; gap: .45rem; }
