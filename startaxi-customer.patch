+#contact-list p { margin-block: .5rem; overflow-wrap: anywhere; }
+#offer-list ul { margin-block: .5rem; padding-left: 1.25rem; }
+.map-pin { background: #ffcf39; border: 3px solid #111e2c; border-radius: 50%; box-shadow: 0 1px 6px #10233666; }
+@media (max-width: 500px) {
+  #panel { margin: auto .5rem max(.5rem, env(safe-area-inset-bottom)); }
+}
