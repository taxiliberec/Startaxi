+#panel { width: min(calc(100% - 1rem), 33rem); max-height: 90dvh; border-radius: 19px; }
+#menu { width: min(22rem, 90vw); max-width: none; height: 100dvh; max-height: none; margin: 0 auto 0 0; padding: max(1rem, env(safe-area-inset-top)) 1rem 1rem; border-radius: 0 18px 18px 0; }
+.dialog-head { display: flex; align-items: center; justify-content: space-between; gap: .75rem; margin-bottom: .65rem; }
+.close { min-width: 44px; font-size: 1.4rem; padding-block: .2rem; }
+#menu nav { display: grid; gap: .45rem; margin-block: 1rem; }
+#menu nav button { text-align: left; }
+#customer-name { color: var(--muted); }
+.address-actions, .payment { display: flex; gap: .55rem; flex-wrap: wrap; }
+.address-actions button, .suggestions button { font-size: .875rem; }
+.suggestions { display: grid; gap: .3rem; }
+.suggestions:empty { display: none; }
+.suggestions button { text-align: left; }
+fieldset { min-width: 0; border: 1px solid var(--line); border-radius: 10px; margin: 0; }
+legend { font-weight: 650; font-size: .875rem; }
+.payment label { display: flex; align-items: center; min-height: 35px; }
