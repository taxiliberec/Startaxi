+#panel-message:not(:empty) { margin-bottom: .8rem; }
+#app, #map { position: fixed; inset: 0; }
+#map { z-index: 0; background: #e1ebee; }
+.map-header { position: absolute; z-index: 2; inset: max(.8rem, env(safe-area-inset-top)) 0 auto; padding-inline: 1rem; display: flex; align-items: start; justify-content: space-between; pointer-events: none; }
+.map-header > * { pointer-events: auto; }
